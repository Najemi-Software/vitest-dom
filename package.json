{
    "name": "@najemi-software/vitest-dom",
    "version": "0.0.0",
    "private": false,
    "description": "Custom Vitest matchers to test the state of the DOM, forked from jest-dom.",
    "homepage": "https://github.com/Najemi-Software/vitest-dom#readme",
    "license": "MIT",
    "author": "Martin Najemi <martin@najemi.cz>",
    "contributors": [
        {
            "name": "Chance Strickland",
            "email": "hi@chance.dev"
        },
        {
            "name": "Rory Jennings",
            "email": "48416253+themagickoala@users.noreply.github.com"
        },
        {
            "name": "Martin Litvaj",
            "email": "kamahl19@gmail.com"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Najemi-Software/vitest-dom.git"
    },
    "files": [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "esm"
    ],
    "type": "module",
    "exports": {
        "./matchers": {
            "types": "./esm/matchers.d.ts",
            "default": "./esm/matchers.js"
        },
        "./extend-expect": {
            "types": "./esm/extend-expect.d.ts",
            "default": "./esm/extend-expect.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "pnpm run clean && npm-run-all -p build-ts build-check",
        "build-check": "tsc",
        "build-ts": "tsc -p tsconfig.build.json",
        "clean": "rm -rf ./esm",
        "format": "oxfmt --check",
        "format-fix": "oxfmt",
        "lint": "eslint .",
        "lint-fix": "eslint . --fix",
        "prepare": "husky",
        "test": "vitest",
        "test-once": "vitest run --silent",
        "validate": "pnpm run lint && pnpm run format"
    },
    "dependencies": {
        "chalk": "^5.3.0",
        "dom-accessibility-api": "^0.6.1",
        "lodash-es": "^4.17.21",
        "redent": "^4.0.0"
    },
    "devDependencies": {
        "@types/lodash-es": "^4.17.9",
        "@typescript-eslint/eslint-plugin": "^6.7.0",
        "@typescript-eslint/parser": "^6.7.0",
        "eslint": "^8.49.0",
        "eslint-import-resolver-node": "^0.3.9",
        "eslint-import-resolver-typescript": "^3.6.0",
        "eslint-plugin-import": "^2.28.1",
        "fast-glob": "^3.3.1",
        "happy-dom": "20.14.5",
        "husky": "9.1.7",
        "lint-staged": "17.5.1",
        "npm-run-all": "4.1.5",
        "oxfmt": "^0.70.0",
        "pretty-format": "^28.1.3",
        "typescript": "^5.2.2",
        "vitest": "^0.34.4"
    },
    "peerDependencies": {
        "vitest": ">=0.31.0"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,tsx,jsx}": [
            "sh -c 'eslint --fix \"$@\" || true' --",
            "sh -c 'oxfmt \"$@\" || true' --"
        ],
        "*.json": [
            "sh -c 'oxfmt \"$@\" || true' --"
        ]
    },
    "packageManager": "pnpm@10.15.0"
}
