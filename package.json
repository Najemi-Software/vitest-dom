{
    "name": "@najemi-software/vitest-dom",
    "version": "0.0.0",
    "private": false,
    "description": "Custom Vitest matchers to test the state of the DOM, forked from jest-dom.",
    "homepage": "https://github.com/Najemi-Software/vitest-dom#readme",
    "license": "MIT",
    "author": "Martin Najemi <martin@najemi.cz>",
    "contributors": [
        {
            "name": "Chance Strickland",
            "email": "hi@chance.dev"
        },
        {
            "name": "Rory Jennings",
            "email": "48416253+themagickoala@users.noreply.github.com"
        },
        {
            "name": "Martin Litvaj",
            "email": "kamahl19@gmail.com"
        }
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Najemi-Software/vitest-dom.git"
    },
    "files": [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "esm"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./esm/index.d.ts",
            "default": "./esm/index.js"
        },
        "./extend-expect/v0": {
            "types": "./esm/extend-expect/public/v0.d.ts",
            "default": "./esm/extend-expect/public/v0.js"
        },
        "./extend-expect/v1": {
            "types": "./esm/extend-expect/public/v1.d.ts",
            "default": "./esm/extend-expect/public/v1.js"
        },
        "./extend-expect/v2": {
            "types": "./esm/extend-expect/public/v2.d.ts",
            "default": "./esm/extend-expect/public/v2.js"
        },
        "./extend-expect/v3": {
            "types": "./esm/extend-expect/public/v3.d.ts",
            "default": "./esm/extend-expect/public/v3.js"
        },
        "./extend-expect/v4": {
            "types": "./esm/extend-expect/public/v4.d.ts",
            "default": "./esm/extend-expect/public/v4.js"
        },
        "./extend-expect/v5": {
            "types": "./esm/extend-expect/public/v5.d.ts",
            "default": "./esm/extend-expect/public/v5.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "api-extractor": "mkdir -p api && [ -z \"${CI}\" ] && (api-extractor run -l) || (api-extractor run)",
        "build": "pnpm run clean && npm-run-all -p build-ts build-check && pnpm run api-extractor",
        "build-check": "tsc",
        "build-ts": "tsc -p tsconfig.build.json",
        "clean": "rm -rf ./esm",
        "format": "oxfmt --check",
        "format-fix": "oxfmt",
        "lint": "oxlint . && eslint .",
        "lint-fix": "oxlint . --fix && eslint . --fix",
        "prepare": "husky",
        "test": "vitest",
        "test-once": "vitest run --silent",
        "validate": "pnpm run lint && pnpm run format"
    },
    "dependencies": {
        "chalk": "^5.3.0",
        "dom-accessibility-api": "^0.6.1",
        "lodash-es": "^4.17.21",
        "redent": "^4.0.0"
    },
    "devDependencies": {
        "@gooddata/eslint-config": "11.59.0",
        "@gooddata/oxlint-config": "11.59.0",
        "@microsoft/api-extractor": "^7.59.2",
        "@types/lodash-es": "^4.17.9",
        "@typescript-eslint/eslint-plugin": "8.58.0",
        "@typescript-eslint/parser": "8.58.0",
        "eslint": "9.39.5",
        "eslint-import-resolver-node": "0.4.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-headers": "1.3.3",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-import-esm": "1.2.1",
        "eslint-plugin-jsdoc": "62.1.0",
        "eslint-plugin-no-barrel-files": "1.2.2",
        "eslint-plugin-no-only-tests": "3.3.0",
        "eslint-plugin-sonarjs": "3.0.6",
        "fast-glob": "^3.3.1",
        "globals": "17.2.0",
        "happy-dom": "20.14.5",
        "husky": "9.1.7",
        "jiti": "2.6.1",
        "lint-staged": "17.5.1",
        "npm-run-all": "4.1.5",
        "oxfmt": "^0.70.0",
        "oxlint": "1.85.0",
        "oxlint-plugin-eslint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2",
        "typescript-eslint": "8.70.1",
        "vitest": "5.0.2"
    },
    "peerDependencies": {
        "vitest": ">=0.31.0"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,tsx,jsx}": [
            "sh -c 'eslint --fix \"$@\" || true' --",
            "sh -c 'oxfmt \"$@\" || true' --"
        ],
        "*.json": [
            "sh -c 'oxfmt \"$@\" || true' --"
        ]
    },
    "packageManager": "pnpm@12.6.0"
}
