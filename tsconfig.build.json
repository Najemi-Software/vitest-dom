{
    "include": ["src"],
    "compilerOptions": {
        "noCheck": true,
        "rootDir": "./src",
        "outDir": "./esm",
        "composite": false,
        "declaration": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "inlineSources": false,
        "isolatedModules": true,
        "moduleResolution": "NodeNext",
        "module": "NodeNext",
        "target": "ES2020",
        "lib": ["ES2022", "dom"]
    }
}
